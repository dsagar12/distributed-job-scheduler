# ==============================================================================
# ENVIRONMENT CONFIGURATION - DISTRIBUTED JOB SCHEDULER
# ==============================================================================

# Node Environment
NODE_ENV=development
LOG_LEVEL=debug

# Database (PostgreSQL - Authoritative Source of Truth)
POSTGRES_USER=scheduler_user
POSTGRES_PASSWORD=scheduler_secret_pw
POSTGRES_DB=distributed_job_scheduler
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://scheduler_user:scheduler_secret_pw@localhost:5432/distributed_job_scheduler?schema=public&connection_limit=20&pool_timeout=30

# Coordination & Caching (Redis - Ephemeral Coordination & PubSub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# API Service
API_PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# Authentication & JWT
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_min_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_min_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Worker Fleet Configuration
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=500
WORKER_EMPTY_POLL_DELAY_MS=1500
WORKER_HEARTBEAT_INTERVAL_MS=3000
WORKER_LEASE_DURATION_MS=15000
WORKER_LOCK_GRACE_PERIOD_MS=5000
WORKER_SHUTDOWN_TIMEOUT_MS=10000

# Scheduler Process Configuration
SCHEDULER_POLL_INTERVAL_MS=1000
SCHEDULER_RECOVERY_INTERVAL_MS=5000
SCHEDULER_BATCH_SIZE=100

# Dashboard
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_WS_URL=ws://localhost:3000
