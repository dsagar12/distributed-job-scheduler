# Multi-stage Dockerfile for Scheduler Daemon
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json tsconfig.base.json tsconfig.json ./
COPY packages/types/package.json ./packages/types/
COPY packages/shared/package.json ./packages/shared/
COPY packages/database/package.json ./packages/database/
COPY apps/scheduler/package.json ./apps/scheduler/

RUN npm ci

COPY packages ./packages
COPY apps/scheduler ./apps/scheduler

RUN npm run build --workspace=@scheduler/types
RUN npm run build --workspace=@scheduler/shared
RUN npm run build --workspace=@scheduler/database
RUN npm run build --workspace=@scheduler/scheduler

FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

COPY package.json ./
COPY --from=builder /app/packages/types/package.json ./packages/types/
COPY --from=builder /app/packages/types/dist ./packages/types/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/database/package.json ./packages/database/
COPY --from=builder /app/packages/database/dist ./packages/database/dist
COPY --from=builder /app/apps/scheduler/package.json ./apps/scheduler/
COPY --from=builder /app/apps/scheduler/dist ./apps/scheduler/dist
COPY --from=builder /app/node_modules ./node_modules

CMD ["node", "apps/scheduler/dist/main.js"]
